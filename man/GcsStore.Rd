zarrs_open_array_metadata(url, "basin_mask")
zarrs_close_store(url)

# Public GCS data needs no credentials over HTTPS:
z <- zarr_open(HttpStore$new(
  "https://storage.googleapis.com/pangeo-data/ECCO_basins.zarr"
))
}
}
